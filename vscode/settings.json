{
  "editor.suggestSelection": "first",
  "workbench.startupEditor": "newUntitledFile",
  "breadcrumbs.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.markdownlint": "explicit",
    "source.fixAll.eslint": "explicit",
  },
  "editor.minimap.enabled": false,
  "workbench.colorCustomizations": {
    "settings.headerForeground": "#cba6f7",
    "menu.selectionForeground": "#cba6f7",
    "textLink.foreground": "#89b4fa",
    "menubar.selectionForeground": "#cba6f7",
    "pickerGroup.foreground": "#b4befe",
    "editorSuggestWidget.highlightForeground": "#f38ba8",
    "scrollbarSlider.activeBackground": "#585b7080",
    "progressBar.background": "#a6e3a1",
    "notificationLink.foreground": "#89b4fa",
    "panelTitle.activeBorder": "#cba6f7",
    "breadcrumb.activeSelectionForeground": "#b4befe",
    "settings.modifiedItemIndicator": "#f9e2af",
    "list.highlightForeground": "#89b4fa",
    "list.activeSelectionForeground": "#cdd6f4",
    "list.inactiveSelectionForeground": "#bac2de",
    "editorWidget.resizeBorder": "#585b70",
    "activityBarBadge.background": "#cba6f7",
    "editorWidget.border": "#585b70",
    "settings.modifiedItemForeground": "#f9e2af",
    "tab.activeBorder": "#cba6f7",
  },
  "workbench.iconTheme": "catppuccin-mocha",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "terminal.integrated.fontFamily": "UDEV Gothic NFLG",
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.profiles.osx": {
    "fish": {
      "path": "/opt/homebrew/bin/fish",
    },
  },
  "[json]": {
    "gitlens.codeLens.scopes": ["document"],
    "editor.quickSuggestions": {
      "strings": true,
    },
    "editor.suggest.insertMode": "replace",
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "git.autofetch": true,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.accessibilitySupport": "off",
  "emmet.variables": {
    "lang": "ja",
  },
  "editor.fontFamily": "UDEV Gothic NFLG, SauceCodePro Nerd Font Mono, Monaco, 'Courier New', monospace, ",
  "terminal.integrated.fontSize": 14,
  "editor.fontSize": 14,
  "vsicons.dontShowNewVersionMessage": true,
  "editor.fontWeight": "500",
  "emmet.triggerExpansionOnTab": true,
  "workbench.sideBar.location": "right",
  "[ignore]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "editor.cursorSmoothCaretAnimation": "on",
  "diffEditor.ignoreTrimWhitespace": false,
  "git.confirmSync": false,
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "editor.fontLigatures": true,
  "telemetry.telemetryLevel": "off",
  "workbench.colorTheme": "Catppuccin Mocha",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "gitlens.graph.details.location": "auto",
  "chat.mcp.gallery.enabled": true,
}
