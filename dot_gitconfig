[ghq]
root = ~/gitserver
[user]
name = Matsushita Takeshi
email = 4383381+itwillrain@users.noreply.github.com
[includeIf "gitdir:~/gitserver/github.com/team-lab/"]
	path = ~/.config/git/team-lab.gitconfig
[alias]
s = status -sb
d = diff
a = add
aa = add -A
b = branch
co = checkout
cob = checkout -b
c = commit
cm = commit -m
pso = push origin
pl = pull
plo = pull origin
f = fetch
fup = fetch upstream
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[pull]
rebase = false
[init]
defaultBranch = main
[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true
